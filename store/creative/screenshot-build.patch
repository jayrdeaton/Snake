+// STORE-ART (temporary, App Store header art only, never commit): the real SnakeBoard with two hand-laid snakes, green
+// from the left and yellow from the right, heads two cells either side of one apple in the middle of the header's safe
+// area. Rendered by store/creative/capture-board.mjs at 762 x 327 and a 5.04 pixel ratio.
+import { View } from 'react-native'
+
+import { SnakeBoard } from '@/components/SnakeBoard'
+import type { Direction, GridCell, SnakeEntity, SnakeId } from '@/types'
+import { SNAKE_COLORS } from '@/utils/snakeEngine'
+
+const COLS = 33
+const ROWS = 13
+const CELL = 762 / COLS
+
+function trace(points: GridCell[]): GridCell[] {
+  const cells: GridCell[] = [points[0]]
+  for (let i = 1; i < points.length; i++) {
+    const { x, y } = cells[cells.length - 1]
+    const to = points[i]
+    const dx = Math.sign(to.x - x)
+    const dy = Math.sign(to.y - y)
+    for (let step = 1; step <= Math.abs(to.x - x) + Math.abs(to.y - y); step++) cells.push({ x: x + dx * step, y: y + dy * step })
+  }
+  return cells
+}
+
+const GREEN = trace([
+  { x: 1, y: 11 },
+  { x: 1, y: 2 },
+  { x: 5, y: 2 },
+  { x: 5, y: 10 },
+  { x: 9, y: 10 },
+  { x: 9, y: 3 },
+  { x: 12, y: 3 },
+  { x: 12, y: 6 },
+  { x: 14, y: 6 }
+])
+const YELLOW = GREEN.map(({ x, y }) => ({ x: 32 - x, y: 12 - y }))
+
+function snake(id: SnakeId, body: GridCell[], direction: Direction): SnakeEntity {
+  return { id, body, direction, pendingDirection: null, alive: true, score: body.length - 3, color: SNAKE_COLORS[id], crashCell: null, heldPowerup: null, effects: { speed: null, control: null, shield: null }, peakLength: body.length }
+}
+
+export default function StoreArt() {
+  return (
+    <View style={{ flex: 1, backgroundColor: '#000', justifyContent: 'center' }}>
+      <View style={{ width: COLS * CELL, height: ROWS * CELL }}>
+        <SnakeBoard snakes={[snake(1, GREEN, 'right'), snake(2, YELLOW, 'left')]} food={{ x: 16, y: 6 }} obstacles={[]} portals={[]} tunnels={[]} pickups={[]} phase='playing' cellPx={CELL} grid={{ cols: COLS, rows: ROWS }} tick={1} tickIntervalMs={110} wrapEdges onboarding={false} />
+      </View>
+    </View>
+  )
+}
