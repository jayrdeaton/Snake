+// STORE-AUTOPILOT (temporary, App Store screenshots only, never commit): true once the round is worth a screenshot, so
+// the tick loop holds that exact state. Tightness is the share of body cells touching a part of the body that isn't
+// their neighbor in the chain: low means a loose, spread-out snake rather than tightly packed runs.
+function storeTightness(body: GridCell[]): number {
+  const index = new Map(body.map((c, i) => [`${c.x},${c.y}`, i]))
+  let touching = 0
+  body.forEach((c, i) => {
+    const near = [`${c.x + 1},${c.y}`, `${c.x - 1},${c.y}`, `${c.x},${c.y + 1}`, `${c.x},${c.y - 1}`].some((k) => {
+      const j = index.get(k)
+      return j !== undefined && Math.abs(j - i) > 1
+    })
+    if (near) touching++
+  })
+  return touching / body.length
+}
+function storeAboutToEat(snake: SnakeEntity, food: GridCell): boolean {
+  const head = snake.body[snake.body.length - 1]
+  const d = snake.pendingDirection ?? snake.direction
+  const next = { x: head.x + (d === 'right' ? 1 : d === 'left' ? -1 : 0), y: head.y + (d === 'down' ? 1 : d === 'up' ? -1 : 0) }
+  return next.x === food.x && next.y === food.y
+}
+function storeShotReady(s: SnakeGameState, mode: SnakeMode): boolean {
+  if (s.phase !== 'playing' || s.snakes.some((snake) => !snake.alive)) return false
+  if (mode === 'solo') {
+    const [snake] = s.snakes
+    return snake.body.length >= Math.max(85, Math.round(s.grid.cols * 2.6)) && storeTightness(snake.body) <= 0.25 && storeAboutToEat(snake, s.food)
+  }
+  if (mode !== 'twoPlayer') return false
+  const [a, b] = s.snakes
+  const minLength = Math.max(16, Math.round(s.grid.cols * 0.55))
+  if (a.body.length < minLength || b.body.length < minLength) return false
+  if (storeTightness(a.body) > 0.35 || storeTightness(b.body) > 0.35) return false
+  const gap = Math.min(...a.body.flatMap((p) => b.body.map((q) => Math.abs(p.x - q.x) + Math.abs(p.y - q.y))))
+  return gap >= 6 && (storeAboutToEat(a, s.food) || storeAboutToEat(b, s.food))
+}
