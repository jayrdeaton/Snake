{
  "expo": {
    "name": "Snake",
    "slug": "Snake",
    "version": "1.1.4",
    "scheme": "snake",
    "description": "A classic Snake game with Solo, Vs CPU, and local 2-player pass-and-play modes.",
    "orientation": "portrait",
    "platforms": [
      "ios",
      "android",
      "web"
    ],
    "updates": {
      "fallbackToCacheTimeout": 0,
      "checkAutomatically": "ON_LOAD",
      "url": "https://u.expo.dev/32bc84c9-573d-4735-a1a4-70fb22d3c1a9"
    },
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "userInterfaceStyle": "automatic",
    "web": {
      "bundler": "metro",
      "favicon": "./assets/images/splash-dark.png"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "icon": "./assets/images/icon-dark.png",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.infinitetoken.Snake",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      },
      "icon": {
        "dark": "./assets/images/icon-dark.png",
        "light": "./assets/images/icon-light.png"
      },
      "entitlements": {
        "com.apple.security.application-groups": [
          "group.com.infinitetoken.tastic"
        ]
      }
    },
    "android": {
      "package": "com.infinitetoken.snake"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-light.png",
          "imageWidth": 200,
          "backgroundColor": "#FAFAFA",
          "dark": {
            "image": "./assets/images/splash-dark.png",
            "backgroundColor": "#050505"
          }
        }
      ],
      "expo-asset",
      [
        "expo-audio",
        {
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "enableBackgroundPlayback": false
        }
      ],
      "@tastic/edge-guard",
      "@tastic/core"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "32bc84c9-573d-4735-a1a4-70fb22d3c1a9"
      }
    },
    "owner": "jayrdeaton"
  }
}
